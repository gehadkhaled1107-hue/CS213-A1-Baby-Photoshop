QToolButton { padding: 8px; }
QPushButton:hover, QToolButton:hover { background-color: #14552d; }
QPushButton:pressed, QToolButton:pressed { background-color: #092a15; }
QScrollArea { background: transparent; border: none; }
QScrollArea &gt; QWidget &gt; QWidget { background: transparent; }
QLabel#imageLabel { color: #CCCCCC; }</string>
